{
  "name": "reva-candidate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "npm": "10",
    "node": "22"
  },
  "scripts": {
    "predev": "react-dsfr update-icons && graphql-codegen --config codegen.ts",
    "dev": "next dev -p 3004",
    "prebuild": "react-dsfr update-icons && npm ci --include=dev --prefix ../reva-api && npm run graphql:generate --prefix ../reva-api && graphql-codegen --config codegen.ts",
    "build": "next build && node copy-assets.js",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/packages/reva-candidate/server.js",
    "lint": "eslint src tests",
    "graphql:generate": "graphql-codegen --config codegen.ts",
    "graphql:watch": "graphql-codegen --config codegen.ts --watch",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.32.4",
    "@hookform/resolvers": "^4.1.3",
    "@tanstack/react-query": "^5.80.6",
    "@urql/exchange-auth": "^2.2.1",
    "classnames": "^2.5.1",
    "cookies-next": "^4",
    "date-fns": "^4.1.0",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "keycloak-js": "^26.2.4",
    "lodash": "^4.17.23",
    "next": "^16.3.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "react-hot-toast": "^2.5.2",
    "sharp": "^0.35.3",
    "urql": "^4.2.2",
    "uuid": "^14.0.0",
    "zod": "^3.25.51",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.1",
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/client-preset": "^5.2.4",
    "@parcel/watcher": "^2.5.1",
    "@playwright/test": "^1.58.2",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "msw": "^2.12.14",
    "postcss": "^8.5.10",
    "postcss-url": "^10.1.3",
    "prettier": "^3.5.3",
    "sass": "^1.89.1",
    "tailwindcss": "^3.4.17",
    "type-fest": "^4.41.0",
    "typescript": "5.8.3"
  },
  "overrides": {
    "postcss-url": {
      "minimatch": "3.1.5"
    },
    "sharp": "^0.35.3",
    "brace-expansion@1": "^1.1.18"
  }
}
