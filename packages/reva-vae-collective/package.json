{
  "name": "reva-vae-collective",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "npm": "10",
    "node": "22"
  },
  "scripts": {
    "predev": "react-dsfr update-icons && graphql-codegen --config codegen.ts",
    "dev": "next dev -p 3005",
    "prebuild": "react-dsfr update-icons && npm ci --include=dev --prefix ../reva-api && npm run graphql:generate --prefix ../reva-api && graphql-codegen --config codegen.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests",
    "test": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "graphql:generate": "graphql-codegen --config codegen.ts",
    "graphql:watch": "graphql-codegen --config codegen.ts --watch"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.32.4",
    "@playwright/test": "^1.55.1",
    "@urql/core": "^5.2.0",
    "cookies-next": "^6.0.0",
    "date-fns": "^4.1.0",
    "jwt-decode": "^4.0.0",
    "keycloak-js": "^26.2.4",
    "next": "^16.3.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/client-preset": "^5.2.4",
    "@types/node": "^22",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "msw": "^2.11.3",
    "postcss": "^8.5.10",
    "postcss-url": "^10.1.3",
    "sass": "^1.89.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  },
  "overrides": {
    "postcss-url": {
      "minimatch": "3.1.5"
    },
    "sharp": "^0.35.3",
    "brace-expansion@1": "^1.1.18"
  }
}
