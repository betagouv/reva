{
  "name": "OAuth2 Proxy",
  "description": "Authenticating reverse proxy (ProConnect/OIDC) standing in front of an existing app, e.g. Metabase",
  "repository": "https://github.com/betagouv/oauth2-proxy-buildpack",
  "website": "https://github.com/oauth2-proxy/oauth2-proxy",
  "env": {
    "BUILDPACK_URL": {
      "description": "Buildpack used to deploy oauth2-proxy",
      "value": "https://github.com/betagouv/oauth2-proxy-buildpack#main",
      "required": true
    }
  }
}